BOT_TOKEN=123456:replace-with-token-from-BotFather
# Числовой id чата менеджера. Менеджер сначала нажимает /start у бота.
# Узнать id: команда /chatid в нужном чате. Пустое значение — заявка останется в логах.
MANAGER_CHAT_ID=

# stub — ответы по data/faq.md без ключей.
# openai_compatible — OpenRouter, Groq, Ollama или другой совместимый API.
AI_PROVIDER=stub

# Ключ шлюза. Для локальной Ollama можно оставить пустым.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free

# Сколько последних реплик помнить (сообщения пользователя и бота вместе).
HISTORY_LIMIT=12
# Минимальная близость вопроса к статье FAQ для заглушки, от 0 до 1.
FAQ_MIN_SCORE=0.18
LLM_TIMEOUT_SECONDS=40
LOG_LEVEL=INFO

# Необязательные пути. По умолчанию — файлы в репозитории.
# FAQ_PATH=data/faq.md
# SYSTEM_PROMPT_PATH=prompts/system.txt
